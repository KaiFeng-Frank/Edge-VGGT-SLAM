    "CIP_V66": {
      "original_value_extension": "[V64,1,0]",
      "dummy_value": "[zero64,0,1]",
      "output": "[u64,m,p]",
      "identity": "m_i=Z_i/(Z_i+1); Y=sum_i(u_i/p_i)/sum_i(m_i/p_i)"
    },
    "completion": "FLOAT32 division and ordered sums over partitions 0,1,2 on CPU; no clamping, fitted scalar, CPU Exp or explicit full score matrix.",
