+                           'if probe is not None and probe < 1.0:').replace(
+                           'reason="initial_motion_below_2"', 'reason="initial_motion_below_1"')
+    require(Path(candidate_path).read_text() == expected,
+            'Candidate stream has an undeclared source/math change')
+    return dict(baseline_stream_sha256=BASELINE_STREAM,
+                approved_stream_sha256=APPROVED_STREAM, exact_two_line_delta_verified=True,
