+def validate_single_variable_policy(candidate, baseline):
+    """Keep every runtime StreamConfig/input/RNG field from the pinned baseline."""
+    expected = json.loads(json.dumps(baseline))
+    for parts, value in POLICY_METADATA_OVERRIDES.items():
+        target = expected
+        for part in parts[:-1]:
+            target = target[part]
+        target[parts[-1]] = value
+    expected['research_trial'] = TRIAL_DECLARATION
+    require(candidate == expected, 'Candidate differs beyond declared motion-only policy')
+    require(candidate['stream_config'] == baseline['stream_config'] and
+            candidate['stream_config']['keyframe_threshold'] == 15.0,
+            'Original half StreamConfig/keyframe15 must stay unchanged')
+    return json.loads(json.dumps(TRIAL_DECLARATION))
