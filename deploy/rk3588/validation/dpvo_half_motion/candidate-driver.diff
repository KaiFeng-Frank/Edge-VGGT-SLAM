+def validate_stream_delta(baseline_path, candidate_path):
+    """No self-asserted SHA or parent-module monkeypatch can bypass source guards."""
+    require(sha(baseline_path) == BASELINE_STREAM and sha(candidate_path) == APPROVED_STREAM,
+            'Frozen/approved stream source SHA differs')
